# ReadyLine — environment variables
# Copy this file to .env and fill in real values if you extend the app.
# The hackathon build uses local synthetic CSV data and needs no secrets to run.

# Optional: if you connect a real HUMS/database source instead of the CSV files
# DATA_SOURCE_URL=
# DATA_SOURCE_API_KEY=

# Optional: if you add an LLM call (e.g. watsonx.ai) for narrative summaries
# WATSONX_API_KEY=
# WATSONX_PROJECT_ID=
